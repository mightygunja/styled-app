rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }
    
    // Closet items - TEMPORARY: Open for testing without auth
    match /closetItems/{itemId} {
      allow read, write: if true; // TEMPORARY: Allow all access for testing
      // TODO: Restrict after adding Firebase Authentication:
      // allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      // allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // Looks - public read, open write for now (TODO: restrict after seeding)
    match /looks/{lookId} {
      allow read: if true;
      allow write: if true; // TEMPORARY: Allow seeding
    }
    
    // Look items - public read, open write for now
    match /lookItems/{itemId} {
      allow read: if true;
      allow write: if true; // TEMPORARY: Allow seeding
    }
    
    // Items (shoppable) - public read, open write for now
    match /items/{itemId} {
      allow read: if true;
      allow write: if true; // TEMPORARY: Allow seeding
    }
    
    // Palettes - public read, open write for now
    match /palettes/{paletteId} {
      allow read: if true;
      allow write: if true; // TEMPORARY: Allow seeding
    }
    
    // Favorite looks - TEMPORARY: Open for testing without auth
    match /favoriteLooks/{favoriteId} {
      allow read, write: if true; // TEMPORARY: Allow all access for testing
      // TODO: Restrict after adding Firebase Authentication:
      // allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      // allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}

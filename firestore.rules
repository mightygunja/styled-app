rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Set to true only when DEV_SKIP_AUTH is on in the app (AppNavigator.tsx) for
    // local testing with no real Firebase Auth session - short-circuits every owner
    // check below. Must stay false in anything committed/shipped; redeploy after
    // changing (npx firebase deploy --only firestore:rules).
    function devSkipAuthChecks() {
      return false;
    }

    function isAuthenticated() {
      return devSkipAuthChecks() || request.auth != null;
    }

    function isOwner(userId) {
      return devSkipAuthChecks() || (isAuthenticated() && request.auth.uid == userId);
    }

    function isResourceOwner() {
      return devSkipAuthChecks() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    function isCreatingOwnResource() {
      return devSkipAuthChecks() || (isAuthenticated() && request.resource.data.userId == request.auth.uid);
    }

    // Users collection - doc id == uid
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Saved outfits - owned by userId field
    match /outfits/{outfitId} {
      allow read: if isResourceOwner();
      allow create: if isCreatingOwnResource();
      allow update, delete: if isResourceOwner();
    }

    // Shopping list items - owned by userId field
    match /shoppingListItems/{itemId} {
      allow read: if isResourceOwner();
      allow create: if isCreatingOwnResource();
      allow update, delete: if isResourceOwner();
    }

    // AI stylist chat messages - owned by userId field
    match /chatMessages/{messageId} {
      allow read: if isResourceOwner();
      allow create: if isCreatingOwnResource();
      allow update, delete: if isResourceOwner();
    }

    // Closet items - owned by userId field
    // True when the item's owner has explicitly shared their closet with the
    // caller. The share doc id encodes both parties, so this is a single
    // exists() lookup rather than a query - queries are not available in rules.
    function closetSharedWithCaller(ownerId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/closetShares/$(ownerId + '_' + request.auth.uid));
    }

    match /closetItems/{itemId} {
      allow read: if isResourceOwner() || closetSharedWithCaller(resource.data.userId);
      allow create: if isCreatingOwnResource();
      // Sharing grants read only - a viewer can never modify someone else's closet.
      allow update, delete: if isResourceOwner();
    }

    // Closet shares - readable by either party so both sides can see and manage
    // the relationship; only the owner may grant or revoke it.
    match /closetShares/{shareId} {
      allow read: if isAuthenticated() &&
        (request.auth.uid == resource.data.ownerId || request.auth.uid == resource.data.viewerId);
      allow create, update: if isAuthenticated() && request.auth.uid == request.resource.data.ownerId;
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.ownerId;
    }

    // Looks - shared catalog content, read-only for clients
    match /looks/{lookId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /lookItems/{itemId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Shoppable items - shared catalog content, read-only for clients
    match /items/{itemId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /palettes/{paletteId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Stylists - shared catalog content, seeded via the seedStylists Cloud Function, read-only for clients
    match /stylists/{stylistId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Stylist bookings - owned by userId field
    match /stylistBookings/{bookingId} {
      allow read: if isResourceOwner();
      allow create: if isCreatingOwnResource();
      allow update, delete: if isResourceOwner();
    }

    // Stylist reviews - visible to all signed-in users, only the author can create/edit/remove their own
    match /reviews/{reviewId} {
      allow read: if isAuthenticated();
      allow create: if isCreatingOwnResource();
      allow update, delete: if isResourceOwner();
    }

    // Favorite looks - owned by userId field
    match /favoriteLooks/{favoriteId} {
      allow read: if isResourceOwner();
      allow create: if isCreatingOwnResource();
      allow delete: if isResourceOwner();
      allow update: if isResourceOwner();
    }

    // ==================== SOCIAL FEED ====================

    // Posts - authored by userId, publicly readable to signed-in users
    match /posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isCreatingOwnResource();
      allow update, delete: if isResourceOwner();
    }

    // Likes - visible to all signed-in users, only the liker can create/remove their like
    match /postLikes/{likeId} {
      allow read: if isAuthenticated();
      allow create: if isCreatingOwnResource();
      allow delete: if isResourceOwner();
      allow update: if false;
    }

    // Comments - visible to all signed-in users, only the author can edit/remove
    match /postComments/{commentId} {
      allow read: if isAuthenticated();
      allow create: if isCreatingOwnResource();
      allow update, delete: if isResourceOwner();
    }

    // Saved posts - private to the saving user
    match /savedPosts/{savedId} {
      allow read: if isResourceOwner();
      allow create: if isCreatingOwnResource();
      allow delete: if isResourceOwner();
      allow update: if false;
    }

    // Post collections - private to the owning user
    match /postCollections/{collectionId} {
      allow read: if isResourceOwner();
      allow create: if isCreatingOwnResource();
      allow update, delete: if isResourceOwner();
    }

    // Feed preferences - doc id == uid
    match /feedPreferences/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Public user profiles - doc id == uid
    match /userProfiles/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Follows - visible to signed-in users, only the follower can create/remove their own follow edge
    match /follows/{followId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.followerId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.followerId == request.auth.uid;
      allow update: if false;
    }

    // Notifications - readable/manageable only by the recipient; any signed-in user's
    // action (like, comment, follow) can create a notification for someone else
    match /notifications/{notificationId} {
      allow read: if isResourceOwner();
      allow create: if isAuthenticated();
      allow update, delete: if isResourceOwner();
    }

    // Notification settings - doc id == uid
    match /notificationSettings/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Conversations - only participants can read/write
    match /conversations/{conversationId} {
      allow read, update: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participants;
      allow delete: if isAuthenticated() && request.auth.uid in resource.data.participants;
    }

    // Messages - only participants of the parent conversation can read; only the sender can write
    match /messages/{messageId} {
      allow read: if isAuthenticated() &&
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data.participants;
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid &&
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.participants;
      allow update, delete: if isAuthenticated() && resource.data.senderId == request.auth.uid;
    }

    // User interactions (analytics/recommendation signals) - private to the user
    match /userInteractions/{interactionId} {
      allow read: if isResourceOwner();
      allow create: if isCreatingOwnResource();
      allow update, delete: if isResourceOwner();
    }

    // ==================== SHOPPING MARKETPLACE ====================

    // Wishlist - owned by userId field
    match /wishlistItems/{wishlistId} {
      allow read: if isResourceOwner();
      allow create: if isCreatingOwnResource();
      allow delete: if isResourceOwner();
      allow update: if false;
    }

    // Affiliate click log (monetization analytics) - owned by userId field, append-only
    match /affiliateClicks/{clickId} {
      allow read: if isResourceOwner();
      allow create: if isCreatingOwnResource();
      allow update, delete: if false;
    }

    // ==================== GROUPS & EVENTS ====================

    match /groups/{groupId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAuthenticated(); // member-count increments come from any joining member
      allow delete: if isAuthenticated() && resource.data.createdBy == request.auth.uid;
    }

    match /groupMembers/{membershipId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    match /groupEvents/{eventId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAuthenticated(); // attendee-count increments come from any RSVPing user
      allow delete: if isAuthenticated() && resource.data.createdBy == request.auth.uid;
    }

    match /eventAttendees/{attendeeId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ==================== CHALLENGES ====================

    match /challenges/{challengeId} {
      allow read: if isAuthenticated();
      allow write: if false; // seeded/managed server-side
    }

    match /challengeParticipants/{participantId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /challengeEntries/{entryId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated(); // vote-count increments come from any voting user
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /challengeVotes/{voteId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // ==================== ACCOUNT / SETTINGS ====================

    // Settings doc id == uid
    match /userSettings/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /plannedOutfits/{plannedOutfitId} {
      allow read: if isResourceOwner();
      allow create, update: if isCreatingOwnResource();
      allow delete: if isResourceOwner();
    }

    // Stylist published schedules - anyone signed in may read them (clients
    // need them to see availability); only the stylist may write their own.
    match /stylistSchedules/{stylistId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(stylistId);
    }

    // Stylist applications. The doc id IS the applicant's uid, so an applicant
    // can only ever see their own. Admin review runs through Cloud Functions
    // with admin credentials, which bypass these rules - so no rule here needs
    // to grant anyone a wider read, and none does.
    //
    // `status` is deliberately not writable by the applicant: it is the field
    // that decides whether they become a stylist. Approval is server-side only.
    match /stylistApplications/{applicantId} {
      allow read: if isOwner(applicantId);
      allow create: if isOwner(applicantId)
        && request.resource.data.status == 'pending';
      allow update: if isOwner(applicantId)
        && request.resource.data.status == 'pending'
        && resource.data.status != 'approved';
      allow delete: if false;
    }

    // NOTE: `stylists` is already locked to read-only for clients further up
    // this file, which is exactly what approval requires - only
    // reviewStylistApplication, running with admin credentials, can create a
    // stylist record. No second rule needed here; duplicate matches in
    // Firestore are OR'd, so adding one could only ever loosen it.

    // Edits - visible to the client who bought it and the stylist building it.
    // The client may only ever change status (to request a revision); the
    // stylist owns the looks and the note.
    match /styleEdits/{editId} {
      allow read: if isAuthenticated() &&
        (request.auth.uid == resource.data.userId || request.auth.uid == resource.data.stylistId);
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow update: if isAuthenticated() &&
        (request.auth.uid == resource.data.stylistId ||
         (request.auth.uid == resource.data.userId &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'revisionNote'])));
      allow delete: if false;
    }

    // Receipt inbox tokens - written only by Cloud Functions and the owning
    // user; never readable by clients, since the token is the credential that
    // lets mail reach this user's staging queue.
    match /receiptInboxTokens/{token} {
      allow read: if false;
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow update: if false;
    }

    match /userReceiptInbox/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Staged imports from forwarded email. Created by the webhook with admin
    // credentials, which bypass these rules; clients may only read and resolve
    // their own.
    match /pendingReceiptImports/{importId} {
      allow read: if isResourceOwner();
      allow update: if isResourceOwner();
      allow create: if false;
      allow delete: if isResourceOwner();
    }

    // Trip packing lists - private to the traveller
    match /packingLists/{packingListId} {
      allow read: if isResourceOwner();
      allow create, update: if isCreatingOwnResource();
      allow delete: if isResourceOwner();
    }

    // Resale valuations - private; reveals what the user owns and paid
    match /resaleValuations/{valuationId} {
      allow read: if isResourceOwner();
      allow create, update: if isCreatingOwnResource();
      allow delete: if isResourceOwner();
    }

    match /paymentMethods/{paymentMethodId} {
      allow read: if isResourceOwner();
      allow create: if isCreatingOwnResource();
      allow update, delete: if isResourceOwner();
    }

    // Subscription doc id == uid
    match /subscriptions/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ==================== STYLIST SESSIONS ====================

    match /sessionNotes/{noteId} {
      allow read, create, delete: if isAuthenticated();
      allow update: if false;
    }

    match /sessionRecommendations/{recId} {
      allow read: if isAuthenticated();
      allow write: if false; // written by a stylist-side tool, not built yet
    }

    match /sessionDeliverables/{deliverableId} {
      allow read: if isAuthenticated();
      allow write: if false; // written by a stylist-side tool, not built yet
    }

    match /sessionPhotos/{photoId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if false;
    }
  }
}

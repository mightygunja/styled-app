# Firebase
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id

# Auth - Google Sign-In (Firebase Console -> Authentication -> Sign-in method -> Google)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
# From GoogleService-Info.plist -> CLIENT_ID (Firebase Console -> Project settings -> Your apps -> iOS app)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id.apps.googleusercontent.com

# Auth - Facebook Login
# Both come from developers.facebook.com -> your app -> Settings -> Basic
# (App ID, and Client Token under Advanced). Neither is secret - both ship
# inside the app bundle - but they live here so the repo isn't tied to one
# Facebook project.
#
# Set BOTH or NEITHER. app.config.js only adds the native Facebook plugin when
# both are present, and the Facebook button only renders when the plugin is in
# the build. A half-configured app would fail the iOS build outright.
#
# Also required, in the Facebook app dashboard:
#   - Add the "Facebook Login" product
#   - iOS platform with bundle ID com.adilgunja.styledapp
#   - In Firebase Console -> Authentication -> Sign-in method, enable Facebook
#     and paste the same App ID + App Secret there
EXPO_PUBLIC_FACEBOOK_APP_ID=your_facebook_app_id
EXPO_PUBLIC_FACEBOOK_CLIENT_TOKEN=your_facebook_client_token

# API Configuration
API_BASE_URL=http://localhost:3000/api

# Affiliate Networks
LTK_API_KEY=your_ltk_api_key_here
SHOPSTYLE_API_KEY=your_shopstyle_api_key_here
SKIMLINKS_API_KEY=your_skimlinks_api_key_here

# Image Processing
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
REMOVE_BG_API_KEY=your_remove_bg_api_key

# AI Services
OPENAI_API_KEY=your_openai_api_key
GOOGLE_VISION_API_KEY=your_google_vision_api_key
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_ENVIRONMENT=your_pinecone_environment

# Payment
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key

# Analytics
GOOGLE_ANALYTICS_ID=your_ga_id
POSTHOG_API_KEY=your_posthog_api_key

# Video/Scheduling
ZOOM_API_KEY=your_zoom_api_key
CALENDLY_API_KEY=your_calendly_api_key

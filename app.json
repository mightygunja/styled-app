{
  "expo": {
    "name": "33 Trends",
    "slug": "styled-app-tf",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-hero.png",
      "resizeMode": "cover",
      "backgroundColor": "#FDFBFA"
    },
    "scheme": "styledapp",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.adilgunja.styledapp",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "33 Trends"
      }
    },
    "android": {
      "package": "com.adilgunja.styledapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FDFBFA"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-apple-authentication",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "33 Trends uses your location to show accurate local weather for outfit recommendations."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "33 Trends reads your calendar so it can plan outfits around what you actually have on."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "33 Trends needs access to your photos so you can add clothes to your closet and check items before you buy them.",
          "cameraPermission": "33 Trends uses your camera to photograph clothes for your closet, receipts, and items you're considering in a store."
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.910996223766-6v0a0qq7saqc14grvnusgsr9fe99lodg"
        }
      ],
      "expo-font",
      [
        "expo-build-properties",
        {
          "ios": {
            "extraPods": [
              {
                "name": "AppCheckCore",
                "modular_headers": true
              },
              {
                "name": "GoogleUtilities",
                "modular_headers": true
              },
              {
                "name": "RecaptchaInterop",
                "modular_headers": true
              }
            ]
          }
        }
      ]
    ],
    "owner": "adilgunja",
    "extra": {
      "eas": {
        "projectId": "f6625af5-1743-449a-b00d-1f183756548c"
      }
    }
  }
}

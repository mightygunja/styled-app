// Prisma schema for Styled app

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String            @id @default(uuid())
  email             String            @unique
  password          String
  name              String
  profileImageUrl   String?
  subscriptionTier  SubscriptionTier  @default(FREE)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  
  preferences       UserPreferences?
  closetItems       ClosetItem[]
  favoriteLooks     FavoriteLook[]
  stylingSessions   StylingSession[]
  priceAlerts       PriceAlert[]
  
  @@map("users")
}

model UserPreferences {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  occasions         String[] // ['home', 'work', 'going-out']
  favoriteColors    String[]
  budgetRange       String   // 'budget', 'moderate', 'luxury', 'mixed'
  bodyType          String?  // 'petite', 'regular', 'tall', 'plus'
  lifestyleFilters  String[] // ['modest', 'nursing-friendly', etc.]
  stylePreferences  String[]
  
  // Size preferences stored as JSON
  sizePreferences   Json?
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@map("user_preferences")
}

model TrendPalette {
  id              String   @id @default(uuid())
  name            String
  description     String
  colors          String[] // Array of hex color codes
  occasion        String   // 'home', 'work', 'going-out'
  weekStartDate   DateTime
  imageUrl        String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  looks           Look[]
  
  @@map("trend_palettes")
}

model Look {
  id              String        @id @default(uuid())
  title           String
  description     String?
  occasion        String        // 'home', 'work', 'going-out'
  paletteId       String
  palette         TrendPalette  @relation(fields: [paletteId], references: [id])
  imageUrl        String
  tags            String[]
  isSponsored     Boolean       @default(false)
  embedding       Float[]       // CLIP embedding for visual similarity
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  items           LookItem[]
  favoritedBy     FavoriteLook[]
  
  @@map("looks")
}

model Item {
  id              String     @id @default(uuid())
  name            String
  imageUrl        String
  price           Float
  originalPrice   Float?
  retailer        String
  affiliateLink   String
  category        String     // 'tops', 'bottoms', 'dresses', etc.
  color           String
  sizeRange       String[]
  brand           String?
  inStock         Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  
  lookItems       LookItem[]
  priceHistory    PriceHistory[]
  priceAlerts     PriceAlert[]
  
  @@map("items")
}

model LookItem {
  id              String   @id @default(uuid())
  lookId          String
  look            Look     @relation(fields: [lookId], references: [id], onDelete: Cascade)
  itemId          String
  item            Item     @relation(fields: [itemId], references: [id])
  itemType        String   // 'hero', 'alternate', 'budget-dupe'
  
  @@map("look_items")
}

model ClosetItem {
  id              String     @id @default(uuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Image & Display
  imageUrl        String
  thumbnailUrl    String?    // Optimized thumbnail
  
  // Classification (AI-detected or manual)
  category        String     // 'tops', 'bottoms', 'dresses', 'outerwear', 'shoes', 'accessories'
  subcategory     String?    // 'blouse', 'jeans', 'sneakers', etc.
  color           String
  secondaryColors String[]   // Additional colors
  pattern         String?    // 'solid', 'striped', 'floral', etc.
  
  // Attributes (AI-extracted)
  neckline        String?    // 'crew', 'v-neck', 'scoop', etc.
  sleeveLength    String?    // 'short', 'long', '3/4', 'sleeveless'
  fitType         String?    // 'fitted', 'relaxed', 'oversized'
  fabricTexture   String?    // 'cotton', 'silk', 'denim', etc.
  style           String?    // 'casual', 'formal', 'sporty', etc.
  
  // Metadata
  brand           String?
  seasons         String[]   // ['spring', 'summer', 'fall', 'winter']
  tags            String[]   // User-added tags
  isFavorite      Boolean    @default(false)
  
  // Usage Tracking
  wornCount       Int        @default(0)
  lastWornDate    DateTime?
  purchaseDate    DateTime?
  notes           String?
  
  // AI Embeddings (for similarity search)
  embedding       Json?      // CLIP embedding vector
  aiConfidence    Float?     // Confidence score from AI classification
  
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  
  @@map("closet_items")
}

model FavoriteLook {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lookId          String
  look            Look     @relation(fields: [lookId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  
  @@unique([userId, lookId])
  @@map("favorite_looks")
}

model Stylist {
  id              String           @id @default(uuid())
  name            String
  bio             String
  profileImageUrl String
  specialties     String[]
  hourlyRate      Float
  rating          Float            @default(0)
  reviewCount     Int              @default(0)
  availability    Json             // Store availability schedule as JSON
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  
  sessions        StylingSession[]
  
  @@map("stylists")
}

model StylingSession {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id])
  stylistId       String
  stylist         Stylist        @relation(fields: [stylistId], references: [id])
  sessionType     String         // 'virtual', 'in-person'
  scheduledDate   DateTime
  duration        Int            // in minutes
  status          SessionStatus  @default(SCHEDULED)
  intakeResponses Json?
  deliverables    String[]
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  
  @@map("styling_sessions")
}

model PriceHistory {
  id              String   @id @default(uuid())
  itemId          String
  item            Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  price           Float
  recordedAt      DateTime @default(now())
  
  @@map("price_history")
}

model PriceAlert {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId          String
  item            Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  targetPrice     Float
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  
  @@map("price_alerts")
}

enum SubscriptionTier {
  FREE
  PREMIUM
  PRO
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

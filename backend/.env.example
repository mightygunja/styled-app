# Database
DATABASE_URL="postgresql://user:password@localhost:5432/styled_db?schema=public"

# Server
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# CORS
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# Affiliate Networks
LTK_API_KEY=your_ltk_api_key
SHOPSTYLE_API_KEY=your_shopstyle_api_key
SKIMLINKS_API_KEY=your_skimlinks_api_key

# Image Processing
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
REMOVE_BG_API_KEY=your_remove_bg_api_key

# AI Services
OPENAI_API_KEY=your_openai_api_key
GOOGLE_VISION_API_KEY=your_google_vision_api_key
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_ENVIRONMENT=your_pinecone_environment
PINECONE_INDEX_NAME=styled-items

# Payment
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Email (optional)
SENDGRID_API_KEY=your_sendgrid_api_key
FROM_EMAIL=noreply@styled.app

# Analytics
GOOGLE_ANALYTICS_ID=your_ga_id
POSTHOG_API_KEY=your_posthog_api_key
